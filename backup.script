#!/bin/bash

# Instale este arquivo como /usr/local/bin/backup_mariadb.sh e execute-o via cron:
# 0 0 * * * /usr/local/bin/backup_mariadb.sh > /var/log/backup_mariadb.log 2>&1
#
# Crie /root/.my.cnf com permissao 0600:
# [client]
# user=USUARIO_DO_BANCO
# password=SENHA_DO_BANCO

set -eu

DB_NAME="nuvdesk"
APP_DIR="/var/www/html/nuvdesk/nuvdesk"
BACKUP_DIR="${BACKUP_STORAGE_PATH:-$APP_DIR/storage/app/private/backups}"
MYSQL_DEFAULTS_FILE="${MYSQL_DEFAULTS_FILE:-/root/.my.cnf}"
DATE="$(date +%Y-%m-%d_%H-%M-%S)"
BACKUP_FILE="backup_$DATE.sql"
BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILE"
TEMP_FILE=""

umask 027
install -d -m 0750 "$BACKUP_DIR"

if [ ! -r "$MYSQL_DEFAULTS_FILE" ]; then
    echo "Arquivo de credenciais MySQL nao encontrado ou sem permissao de leitura."
    exit 1
fi

TEMP_FILE="$(mktemp "$BACKUP_DIR/.backup_XXXXXX.sql")"
trap 'if [ -n "$TEMP_FILE" ]; then rm -f -- "$TEMP_FILE"; fi' EXIT

if mysqldump --defaults-extra-file="$MYSQL_DEFAULTS_FILE" -- "$DB_NAME" > "$TEMP_FILE"; then
    chmod 0640 "$TEMP_FILE"
    mv -- "$TEMP_FILE" "$BACKUP_PATH"
    TEMP_FILE=""

    mysql --defaults-extra-file="$MYSQL_DEFAULTS_FILE" --database="$DB_NAME" \
        --execute="INSERT INTO backups (data_hora, local_arquivo, status, created_at, updated_at) VALUES (NOW(), '$BACKUP_FILE', 'sucesso', NOW(), NOW());"

    echo "Backup realizado com sucesso em $BACKUP_PATH"
else
    mysql --defaults-extra-file="$MYSQL_DEFAULTS_FILE" --database="$DB_NAME" \
        --execute="INSERT INTO backups (data_hora, local_arquivo, status, created_at, updated_at) VALUES (NOW(), '$BACKUP_FILE', 'falha', NOW(), NOW());"

    echo "Falha ao realizar o backup."
    exit 1
fi

# Mantem somente os backups dos ultimos sete dias e remove seus registros.
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'backup_*.sql' -mtime +7 -print0 |
while IFS= read -r -d '' old_backup; do
    old_file="${old_backup##*/}"
    if rm -f -- "$old_backup"; then
        mysql --defaults-extra-file="$MYSQL_DEFAULTS_FILE" --database="$DB_NAME" \
            --execute="DELETE FROM backups WHERE local_arquivo = '$old_file' OR local_arquivo LIKE '%/storage/app/public/backup/$old_file';"
    fi
done
